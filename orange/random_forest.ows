		<properties node_id="15" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x01\x00\x00\x00/\x00\x00\x05\xb0\x00\x00\x04b\x00\x00\x00\x01\x00\x00\x00K\x00\x00\x05\xb0\x00\x00\x04b\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x01\x00\x00\x00K\x00\x00\x05\xb0\x00\x00\x04b', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import subprocess\nimport sys\n\n# imbalanced-learn library\nsubprocess.check_call([sys.executable, "-m", "pip", "install", "imbalanced-learn"])\n\nprint("oke library")\n\n\n\n\nfrom imblearn.over_sampling import SMOTE\nfrom Orange.data import Table\nimport numpy as np\n\n#data\nprint(f"avant: {len(in_data)} patient")\n\n# SMOTE app\nsmote = SMOTE(random_state=42, k_neighbors=3)\nX_resampled, y_resampled = smote.fit_resample(in_data.X, in_data.Y)\n\n# Orange  convertire Table\nout_data = Table.from_numpy(in_data.domain, X_resampled, y_resampled)\n\nprint(f"apres: {len(out_data)} patient")\nprint("smote finis")', 'filename': None}], 'scriptText': 'import subprocess\nimport sys\n\n# imbalanced-learn library\nsubprocess.check_call([sys.executable, "-m", "pip", "install", "imbalanced-learn"])\n\nprint("oke library")\n\n\n\n\nfrom imblearn.over_sampling import SMOTE\nfrom Orange.data import Table\nimport numpy as np\n\n#data\nprint(f"avant: {len(in_data)} patient")\n\n# SMOTE app\nsmote = SMOTE(random_state=42, k_neighbors=3)\nX_resampled, y_resampled = smote.fit_resample(in_data.X, in_data.Y)\n\n# Orange  convertire Table\nout_data = Table.from_numpy(in_data.domain, X_resampled, y_resampled)\n\nprint(f"apres: {len(out_data)} patient")\nprint("smote finis")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
